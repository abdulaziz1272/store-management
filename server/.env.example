# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to Git.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas is required: transactions need a replica set)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/store?retryWrites=true&w=majority

# Long random text used to sign login tokens. Example generator:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Store timezone: Uzbekistan is UTC+5 all year (no daylight saving)
STORE_UTC_OFFSET_HOURS=5
STORE_TIMEZONE=Asia/Tashkent

# A cashier cannot give a discount bigger than this percent (manager/admin can)
MAX_CASHIER_DISCOUNT_PERCENT=10

# Telegram daily report
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret for the daily-report trigger URL (used by an external scheduler)
CRON_SECRET=change-this-too

# Set to true to also run the daily report inside this server at 00:00.
# (On Render free plan the server sleeps, so prefer the external scheduler.)
ENABLE_INTERNAL_CRON=false

# Only used by "npm run seed" to create the first admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123
